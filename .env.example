# CryptoTrump Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ========================================
# NETWORK CONFIGURATION
# ========================================

# Private key for deployment (without 0x prefix)
# IMPORTANT: Use a deployment wallet, not your main wallet!
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Polygonscan API key
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Arbiscan API key
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Optimistic Etherscan API key
OPTIMISTIC_ETHERSCAN_API_KEY=your_optimistic_etherscan_api_key_here

# Basescan API key
BASESCAN_API_KEY=your_basescan_api_key_here

# ========================================
# RPC ENDPOINTS
# ========================================

# Ethereum Mainnet RPC
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum Sepolia Testnet RPC
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon Mainnet RPC
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Polygon Mumbai Testnet RPC
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum One RPC
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Arbitrum Sepolia Testnet RPC
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optimism Mainnet RPC
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optimism Sepolia Testnet RPC
OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Base Mainnet RPC
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Base Sepolia Testnet RPC
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ========================================
# LAYERZERO CONFIGURATION
# ========================================

# LayerZero Endpoint addresses (V2)
LZ_ENDPOINT_ETHEREUM=0x1a44076050125825900e736c501f859c50fE728c
LZ_ENDPOINT_POLYGON=0x1a44076050125825900e736c501f859c50fE728c
LZ_ENDPOINT_ARBITRUM=0x1a44076050125825900e736c501f859c50fE728c
LZ_ENDPOINT_OPTIMISM=0x1a44076050125825900e736c501f859c50fE728c
LZ_ENDPOINT_BASE=0x1a44076050125825900e736c501f859c50fE728c

# ========================================
# CONTRACT ADDRESSES (fill after deployment)
# ========================================

CONTRACT_ADDRESS_ETHEREUM=
CONTRACT_ADDRESS_POLYGON=
CONTRACT_ADDRESS_ARBITRUM=
CONTRACT_ADDRESS_OPTIMISM=
CONTRACT_ADDRESS_BASE=

# ========================================
# IPFS CONFIGURATION
# ========================================

# Pinata API credentials
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here

# NFT.Storage API key
NFT_STORAGE_API_KEY=your_nft_storage_api_key_here

# Web3.Storage API key
WEB3_STORAGE_API_KEY=your_web3_storage_api_key_here

# IPFS CIDs (fill after upload)
IPFS_IMAGES_CID=
IPFS_METADATA_CID=

# ========================================
# GAS CONFIGURATION
# ========================================

GAS_PRICE=50
MAX_FEE_PER_GAS=100
MAX_PRIORITY_FEE_PER_GAS=2

# ========================================
# TESTING CONFIGURATION
# ========================================

REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ========================================
# DEVELOPMENT CONFIGURATION
# ========================================

DEBUG=false
DEFAULT_NETWORK=sepolia

# ========================================
# SECURITY
# ========================================

OWNER_ADDRESS=your_owner_address_here
PAUSE_ADDRESS=your_pause_address_here
